{
  "name": "liv-ai-scripts",
  "version": "0.1.0",
  "type": "module",
  "main": "electron/dist/main.js",
  "bin": {
    "liv-ai": "./node_modules/.bin/tsx src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "ui:server": "tsx ui-server/index.ts",
    "ui:web": "cd ui && npm run dev",
    "ui": "concurrently -k -n server,web -c cyan,magenta \"npm:ui:server\" \"npm:ui:web\"",
    "ui:install": "cd ui && npm install",
    "ui:build": "cd ui && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently \"npm:ui:server\" \"npm:ui:web\" \"wait-on http://localhost:4317 && electron .\"",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/check-deps.js",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.1",
    "archiver": "^7.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "electron-store": "^11.0.2",
    "fastify": "^5.8.5",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^6.33.0",
    "ora": "^8.1.1",
    "pdf-parse": "^1.1.1",
    "pizzip": "^3.2.0",
    "pptx-automizer": "^0.8.1",
    "pptxgenjs": "^3.12.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/archiver": "^6.0.3",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
